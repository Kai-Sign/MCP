# Generated for you by deploy/wizard.html — or fill in by hand.

# Network the light client follows: mainnet | sepolia | hoodi | gnosis
LC_NETWORK=mainnet
# Trust anchor (initial finalized beacon root). A trust decision: pick a provider you trust.
LC_CHECKPOINT_URL=https://mainnet.checkpoint.sigp.io

# Tailscale: create a key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=kaisign

# Secrets (>= 32 URL-safe chars each, different from each other): openssl rand -hex 32
KAISIGN_RPC_TOKEN=
KAISIGN_APPROVAL_KEY=
# Optional, only used for the links printed in the logs
KAISIGN_PUBLIC_URL=

# none | safe
KAISIGN_AUTO_APPROVE=none

# Optional one-time activation fee, verified on-chain by this node (USDC on mainnet/Sepolia)
KAISIGN_FEE_RECIPIENT=
KAISIGN_FEE_AMOUNT=

# Optional: also verify the KaiSign registry (Sepolia) through a second light client.
# Start with: docker compose --profile verified-registry up -d
# COMPOSE_PROFILES=verified-registry
# LIGHT_CLIENT_RPC_URL=11155111=http://light-client-sepolia:8545
