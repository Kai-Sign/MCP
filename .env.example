# KaiSign MCP Server - Environment Variables
# Copy this file to .env and fill in your values


# ─── KaiSign API ────────────────────────────────────────────
# Optional: Custom KaiSign API endpoint
# KAISIGN_API_URL=https://kai-sign-production.up.railway.app

# ─── Verified ABI / metadata generation ─────────────────────
# Optional: Etherscan v2 key for scripts/generate-erc7730-from-etherscan.mjs
# ETHERSCAN_API_KEY=

# ─── Nethermind light client (NethermindEth/nethermind#14457) ───
# Verified JSON-RPC. Chains it serves are read through it (registry attestations,
# proxy slots) with no fallback to public RPCs for those trusted reads.
# LIGHT_CLIENT_RPC_URL=http://127.0.0.1:8545
# Several clients / pinned chains: 11155111=http://127.0.0.1:8547,1=http://127.0.0.1:8545
# Forbid replaying registry logs from public RPCs when the light client lacks the range:
# LIGHT_CLIENT_ONLY=true

# ─── KaiSign Wallet RPC (npm run start:wallet-rpc) ──────────
# KAISIGN_WALLET_RPC_UPSTREAM=http://127.0.0.1:8545
# KAISIGN_WALLET_RPC_PORT=8546
# none = every transaction needs a click; safe = SAFE verdicts relay automatically
# KAISIGN_AUTO_APPROVE=none
# KAISIGN_APPROVAL_TIMEOUT_SECONDS=300

# ─── RPC URLs ───────────────────────────────────────────────
# Optional: Override default public RPC endpoints
# Using authenticated RPCs (Alchemy, Infura, etc.) is recommended for production

# Ethereum Mainnet (Chain ID: 1)
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Base (Chain ID: 8453)
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optimism (Chain ID: 10)
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum (Chain ID: 42161)
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Sepolia Testnet (Chain ID: 11155111) - Used for KaiSign Registry
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
